+"""Outgoing frame queue with optional per-topic coalescing.
+
+The sender queue was an unbounded FIFO: a client reading slower than
+publishers publish grows the queue without limit, and every queued state
+message adds latency — the client renders ever-staler data. For state
+streams (poses, clock), only the LATEST message matters; commands and
+system frames must keep strict FIFO order and never be dropped.
+
+Topics matched by a coalesce pattern keep at most ONE pending frame:
+a later put replaces the pending frame instead of queuing behind it.
+Everything else (topic=None system frames included) is plain FIFO.
+
+Standard library only, so it stays unit-testable without rclpy.
+"""
+
+import threading
+from queue import Queue
+
+
+class OutgoingQueue:
+    """Thread-safe outgoing queue; drop-in for the previous queue.Queue usage."""
+
+    def __init__(self, coalesce_patterns=()):
+        """coalesce_patterns: compiled regexes; matching topics keep only the latest frame."""
+        self._patterns = tuple(coalesce_patterns)
+        self._tokens = Queue()
+        self._lock = threading.Lock()
+        self._latest = {}  # topic -> frame, one slot per coalesced topic
+
+    def _coalesced(self, topic):
+        return topic is not None and any(p.search(topic) for p in self._patterns)
+
+    def put(self, topic, frame):
+        if not self._coalesced(topic):
+            self._tokens.put(frame)
+            return
+        with self._lock:
+            pending = topic in self._latest
+            self._latest[topic] = frame
+        if not pending:
+            self._tokens.put(_Token(topic))
+
+    def get(self, timeout=None):
+        item = self._tokens.get(timeout=timeout)  # raises queue.Empty on timeout
+        if isinstance(item, _Token):
+            with self._lock:
+                return self._latest.pop(item.topic)
+        return item
+
+
+class _Token:
+    """Marker queued once per coalesced topic with a pending frame."""
+
+    __slots__ = ("topic",)
+
+    def __init__(self, topic):
+        self.topic = topic
