+#  Copyright 2026 Naval Group
+#  Licensed under the Apache License, Version 2.0 (the "License");
+#  See http://www.apache.org/licenses/LICENSE-2.0
+
+"""Unit tests for OutgoingQueue — stdlib only, no rclpy required.
+
+Run directly (python3 test/test_outgoing_queue.py) or through pytest.
+"""
+
+import importlib.util
+import re
+import threading
+from pathlib import Path
+from queue import Empty
+
+# Load the module by path: the package __init__ imports rclpy, which this
+# stdlib-only test must not require.
+_spec = importlib.util.spec_from_file_location(
+    "outgoing_queue",
+    Path(__file__).resolve().parent.parent / "ros_tcp_endpoint" / "outgoing_queue.py",
+)
+assert _spec is not None and _spec.loader is not None
+_mod = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(_mod)
+OutgoingQueue = _mod.OutgoingQueue
+
+POSES = (re.compile(r"renderer_poses$"),)
+
+
+def test_fifo_without_patterns():
+    q = OutgoingQueue()
+    for frame in (b"a", b"b", b"c"):
+        q.put("any/topic", frame)
+    assert [q.get(timeout=1) for _ in range(3)] == [b"a", b"b", b"c"]
+
+
+def test_system_frames_keep_order_with_patterns():
+    q = OutgoingQueue(POSES)
+    q.put(None, b"handshake")
+    q.put("lotusim/renderer_cmd", b"create")
+    assert q.get(timeout=1) == b"handshake"
+    assert q.get(timeout=1) == b"create"
+
+
+def test_coalesced_topic_keeps_only_latest():
+    q = OutgoingQueue(POSES)
+    for i in range(100):
+        q.put("lotusim/renderer_poses", b"pose%d" % i)
+    assert q.get(timeout=1) == b"pose99"
+    try:
+        q.get(timeout=0.05)
+        raise AssertionError("queue should be empty after coalescing")
+    except Empty:
+        pass
+
+
+def test_coalesced_token_keeps_arrival_order():
+    q = OutgoingQueue(POSES)
+    q.put("lotusim/renderer_poses", b"stale")
+    q.put(None, b"command")
+    q.put("lotusim/renderer_poses", b"fresh")  # replaces, no new token
+    assert q.get(timeout=1) == b"fresh"
+    assert q.get(timeout=1) == b"command"
+
+
+def test_topic_requeues_after_get():
+    q = OutgoingQueue(POSES)
+    q.put("lotusim/renderer_poses", b"one")
+    assert q.get(timeout=1) == b"one"
+    q.put("lotusim/renderer_poses", b"two")
+    assert q.get(timeout=1) == b"two"
+
+
+def test_flooded_producer_bounded_consumer():
+    q = OutgoingQueue(POSES)
+    n = 5000
+    seen = []
+
+    def produce():
+        for i in range(n):
+            q.put("lotusim/renderer_poses", i.to_bytes(4, "big"))
+
+    t = threading.Thread(target=produce)
+    t.start()
+    t.join()
+    while True:
+        try:
+            seen.append(q.get(timeout=0.1))
+        except Empty:
+            break
+    assert len(seen) <= n
+    assert seen[-1] == (n - 1).to_bytes(4, "big")  # the latest always arrives
+    values = [int.from_bytes(f, "big") for f in seen]
+    assert values == sorted(values)  # never re-delivers older data after newer
+
+
+if __name__ == "__main__":
+    for name, fn in sorted(globals().items()):
+        if name.startswith("test_"):
+            fn()
+            print(f"ok {name}")
+    print("all tests passed")
