+        # State streams (poses, clock…) want the latest sample, not a reliable
+        # backlog: BEST_EFFORT/VOLATILE/KEEP_LAST(1) when the topic matches the
+        # server's BEST_EFFORT_TOPICS patterns. DDS accepts a BEST_EFFORT
+        # subscriber under a RELIABLE publisher, so this is opt-in per topic
+        # with the historical profile as the default.
+        best_effort = any(
+            p.search(topic) for p in getattr(tcp_server, "best_effort_patterns", ())
         )
+        if best_effort:
+            qos_profile = QoSProfile(
+                history=QoSHistoryPolicy.KEEP_LAST,
+                depth=1,
+                reliability=QoSReliabilityPolicy.BEST_EFFORT,
+                durability=QoSDurabilityPolicy.VOLATILE,
+            )
